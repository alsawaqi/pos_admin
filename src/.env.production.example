# =============================================================================
# pos_admin — PRODUCTION .env template  (posadmin.mithqal.net)
# Copy to `src/.env` on the VPS and fill the secrets (APP_KEY, DB_PASSWORD).
#   cp src/.env.production.example src/.env
# =============================================================================

APP_NAME="MITHQAL POS Admin"
APP_ENV=production
# Generate ONCE, then paste the SAME value into pos_merchant's .env.
# pos_admin encrypts PII (phone, civil_id) on the shared pos_users table with
# this key — a mismatch makes every encrypted read fail "MAC is invalid".
#   docker compose -f docker-compose.prod.yml run --rm artisan php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://posadmin.mithqal.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs go to stderr -> docker logs (compose also forces LOG_CHANNEL=stderr).
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Sentry (optional) — set the project DSN to enable error reporting in prod.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ---- Shared charity Postgres (charity_db) on charity_net --------------------
DB_CONNECTION=pgsql
DB_HOST=chariyt-db
DB_PORT=5432
DB_DATABASE=charity_db
DB_USERNAME=charity_user
DB_PASSWORD=
# pos_admin tracks ITS migrations here, isolated from charity's `migrations`
# table. `migrate --force` is additive; never run migrate:fresh/rollback/wipe.
DB_MIGRATIONS_TABLE=pos_admin_migrations

POS_ADMIN_IDLE_TIMEOUT_MINUTES=30
POS_ADMIN_JWT_TTL_MINUTES=60
POS_ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
POS_ADMIN_DEFAULT_NAME="MITHQAL Admin"
POS_ADMIN_DEFAULT_EMAIL=admin@mithqal.net
POS_ADMIN_DEFAULT_PASSWORD=

# ---- Sessions / cache / queue (Redis) --------------------------------------
# These canonical framework tables belong to the shared charity database.
# Never point production back at the retired pos_admin_* copies.
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
SESSION_TABLE=sessions
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks
DB_QUEUE_TABLE=jobs
QUEUE_BATCHES_TABLE=job_batches
QUEUE_FAILED_TABLE=failed_jobs

SESSION_DRIVER=redis
SESSION_COOKIE=pos_admin_web_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Host-only cookie per subdomain — keep null so posadmin + posmerchant don't
# share a session cookie.
SESSION_DOMAIN=null
# We sit behind an HTTPS reverse proxy (trustProxies is on), so issue secure
# cookies only over TLS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb

# Reverb publisher credentials stay blank in committed templates.
# In live .env files, REVERB_APP_ID, REVERB_APP_KEY and REVERB_APP_SECRET
# must be byte-identical across pos_api, pos_admin and pos_merchant: all three
# address the same server and sign the same HMAC.
# Laravel APP_KEY is unrelated; Reverb signatures use REVERB_APP_SECRET.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=pos_api_reverb
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must exceed the longest queued job timeout (currently 600 seconds).
REDIS_QUEUE_RETRY_AFTER=660

CACHE_STORE=redis
CACHE_PREFIX=pos_admin_cache

REDIS_CLIENT=phpredis
# Matches the unique redis service name in docker-compose.prod.yml.
REDIS_HOST=pos_admin_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Email (LAUNCH-P1 P1-3) ------------------------------------------------
# Set-password links (new merchant logins, new admins, admin resets) and the
# admin "Forgot password?" mail go out by SMTP from an existing mailbox.
# The owner fills MAIL_HOST / MAIL_PORT / MAIL_USERNAME and types
# MAIL_PASSWORD on the server himself — never commit it.
# A failed send never breaks the request: the admin still gets the
# "Copy set-password link" button. With MAIL_MAILER=log nothing is emailed
# at all (links are never written to the log).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls = STARTTLS (usually port 587); ssl = implicit TLS (usually port 465).
MAIL_ENCRYPTION=tls
# Seconds before an unreachable mail server is given up on.
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=noreply@mithqal.net
MAIL_FROM_NAME=MITHQAL

# The merchant portal's public address — the base of the set-password links
# sent to merchant users (pos_merchant's /setup-password and /reset-password).
MERCHANT_PORTAL_URL=https://posmerchant.mithqal.net

# ---- Document storage --------------------------------------------------------
# LAUNCH-P1 P1-1: merchant documents live on the PRIVATE local disk
# storage/app/private/documents (inside the storage-data volume, archived by
# ops/backup/charity-db-backup.sh). Leave DOCUMENTS_LOCAL_ROOT empty for that
# default. S3 only if explicitly configured (needs the S3 adapter package).
DOCUMENTS_DISK_DRIVER=local
DOCUMENTS_LOCAL_ROOT=

# LAUNCH-P1 P1-15: authenticator 2FA is required for every admin. Leave true;
# false is an emergency break-glass only.
POS_ADMIN_TWO_FACTOR_REQUIRED=true

# ---- Front-end build (Vite) ------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=https://posadmin.mithqal.net
# Public, referrer-restricted Google Maps key (ships in the JS bundle — lock it
# to posadmin.mithqal.net in the Google Cloud console).
VITE_GOOGLE_MAPS_API_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Scalefusion (MDM) — set the token for live device data ----------------
SCALEFUSION_TOKEN=
SCALEFUSION_BASE_V3=https://api.scalefusion.com/api/v3
SCALEFUSION_BASE_V1=https://api.scalefusion.com/api/v1
